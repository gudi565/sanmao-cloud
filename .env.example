# 复制为 .env 并填入真实值
# SQLite 数据库文件路径（file: 相对 prisma/schema.prisma 所在目录解析）
DATABASE_URL="file:./dev.db"

# JWT 签名密钥，用 `openssl rand -base64 32` 生成
AUTH_SECRET=""

# 邮件 SMTP（发送验证码用）——全部留空则验证码打印到终端（开发模式）
# EMAIL_PASS 是邮箱授权码（非登录密码）。常见：QQ smtp.qq.com / 163 smtp.163.com，端口 465
EMAIL_HOST=""
EMAIL_PORT="465"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM=""

# 阿里云短信（手机号验证码）——全部留空则打印到终端（开发模式）
# 模板需含变量 ${code}。AccessKey 用 RAM 子账号（仅短信权限）；签名/模板需审核
SMS_ACCESS_KEY_ID=""
SMS_ACCESS_KEY_SECRET=""
SMS_SIGN_NAME=""
SMS_TEMPLATE_CODE=""
